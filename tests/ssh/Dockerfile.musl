FROM alpine:3.22
RUN apk add --no-cache openssh sudo shadow util-linux \
    && mkdir -p /run/sshd \
    && useradd -m -s /bin/sh deploy \
    && useradd -m -s /bin/sh app \
    && passwd -d deploy \
    && printf 'deploy ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/deploy \
    && chmod 0440 /etc/sudoers.d/deploy
CMD ["sh", "-c", "ssh-keygen -A >/dev/null && exec /usr/sbin/sshd -D -e"]
