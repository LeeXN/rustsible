FROM alpine:3.22
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    apk add --no-cache openssh sudo shadow util-linux ca-certificates libcap-utils \
    && mkdir -p /run/sshd \
    && useradd -m -s /bin/sh deploy \
    && useradd -m -s /bin/sh app \
    && passwd -d deploy \
    && printf 'deploy ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/deploy \
    && chmod 0440 /etc/sudoers.d/deploy
CMD ["sh", "-c", "ssh-keygen -A >/dev/null && exec /usr/sbin/sshd -D -e"]
